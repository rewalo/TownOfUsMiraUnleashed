<!-- Wraith Role -->
    <string name="MiraUnleashed.Role.Wraith">Wraith</string>
    <string name="MiraUnleashed.Role.Wraith.IntroBlurb">Move fast and strike unpredictably.</string>
    <string name="MiraUnleashed.Role.Wraith.TabDescription">Dash for speed. Place a Lantern to teleport back to it.</string>
    <string name="MiraUnleashed.Role.Wraith.WikiDescription">The Wraith is an Impostor Power role focused on fast, unpredictable movement. Dash increases your movement speed by 75% for a short time. Lantern lets you place a hidden marker only you can see; reactivate it to teleport back and briefly swoop. If the Lantern expires before you return, it breaks and leaves permanent evidence visible to all players.</string>
    <string name="MiraUnleashed.Role.WraithDash">Dash</string>
    <string name="MiraUnleashed.Role.WraithDash.WikiDescription">Temporarily increase your movement speed by 75%.</string>
    <string name="MiraUnleashed.Role.WraithLantern">Lantern</string>
    <string name="MiraUnleashed.Role.WraithLantern.WikiDescription">Place a Lantern only you can see. Reactivate it to teleport back and briefly turn invisible. If it expires, it breaks and leaves evidence visible to everyone.</string>
    <string name="MiraUnleashed.Role.WraithLanternPlace">Lantern</string>
    <string name="MiraUnleashed.Role.WraithLanternReturn">Return</string>

