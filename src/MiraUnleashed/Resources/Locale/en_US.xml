<!-- Hacker Role -->
    <string name="MiraUnleashed.Role.Hacker">Hacker</string>
    <string name="MiraUnleashed.Role.Hacker.IntroBlurb">Download system information and jam comms.</string>
    <string name="MiraUnleashed.Role.Hacker.TabDescription">Download and jam equipment, kill for extra jam charges.</string>
    <string name="MiraUnleashed.Role.Hacker.WikiDescription">The Hacker is an Impostor Support role that can download information from nearby equipment to charge a portable device. Once you start downloading, you're locked into that equipment type until the next round. Jam disrupts information systems as if comms were sabotaged, but emergency meetings can still be called.</string>
    <string name="MiraUnleashed.Role.HackerDownload">Download</string>
    <string name="MiraUnleashed.Role.HackerDownload.WikiDescription">While near a downloadable console (Admin/Cams/Vitals/Door Log), download to charge your battery. Every 1 second downloading grants 2 seconds of device battery (configurable). You cannot switch equipment type until the next round.</string>
    <string name="MiraUnleashed.Role.HackerDevice">Device</string>
    <string name="MiraUnleashed.Role.HackerDevice.WikiDescription">Use the downloaded system anywhere, consuming battery over time.</string>
    <string name="MiraUnleashed.Role.HackerJam">Jam</string>
    <string name="MiraUnleashed.Role.HackerJam.WikiDescription">Spend a Jam charge to disrupt information systems for a duration. This behaves like comms being down, but does not prevent calling emergency meetings.</string>

