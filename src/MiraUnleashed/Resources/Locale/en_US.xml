<!-- Trapper Role -->
    <string name="MiraUnleashed.Role.Trapper">Trapper</string>
    <string name="MiraUnleashed.Role.Trapper.IntroBlurb">Trap vents to catch venters.</string>
    <string name="MiraUnleashed.Role.Trapper.TabDescription">Place traps on vents. Players who use trapped vents will be immobilized for a duration.</string>
    <string name="MiraUnleashed.Role.Trapper.WikiDescription">The Trapper is a Crewmate role that can place traps on vents. When players use a trapped vent, they are immobilized for a duration and the Trapper is notified.</string>
    <string name="MiraUnleashed.Role.TrapperTrap">Trap</string>
    <string name="MiraUnleashed.Role.TrapperTrap.WikiDescription">Place a trap on a vent. Players who use this vent will be caught and immobilized.</string>
