    <string name="MiraUnleashed.Role.Witch.IntroBlurb">We love casting spells!</string>
    <string name="MiraUnleashed.Role.Witch.TabDescription">Cast spells on players.\%nl\%They'll be highlighted in the next meeting and die after the configured amount of meetings.</string>
