<!-- Renamed Trapper to Revealer - these override the base mod's Trapper strings
     (TOU-Mira 1.7.3 looks up TownOfUsMira.Role.<IdPart>* keys; the IdPart patch returns "Revealer") -->
    <string name="TownOfUsMira.Role.Revealer">Revealer</string>
    <string name="TownOfUsMira.Role.Revealer.IntroBlurb">Place traps to reveal roles of players who stay in them.</string>
    <string name="TownOfUsMira.Role.Revealer.TabDescription">Place traps around the map. Players who stay in traps long enough will have their roles revealed to you at the next meeting.</string>
    <string name="TownOfUsMira.Role.Revealer.WikiDescription">The Revealer is a Crewmate role that can place traps around the map. When players stay in a trap for a certain amount of time, their roles are revealed to the Revealer at the next meeting.</string>
    <string name="TownOfUsMira.Role.RevealerTrap">Trap</string>
    <string name="TownOfUsMira.Role.RevealerTrap.WikiDescription">Place a trap at your current location. Players who stay in the trap for the required duration will have their roles revealed to you.</string>
    <string name="TownOfUsMira.Role.RevealerNoPlayers">No players were caught in your traps.</string>
    <string name="TownOfUsMira.Role.RevealerNotEnoughPLayers">Not enough players were caught in your traps.</string>
