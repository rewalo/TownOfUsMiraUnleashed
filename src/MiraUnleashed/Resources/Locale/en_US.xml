    <string name="MiraUnleashed.Role.CharlatanConceal">Conceal</string>
    <string name="MiraUnleashed.Role.CharlatanConceal.WikiDescription">Reduce the report range of nearby bodies. You must stay near the body for the duration to successfully conceal it.</string>

