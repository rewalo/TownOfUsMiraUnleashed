    <string name="MiraUnleashed.Role.Scavenger">Scavenger</string>
    <string name="MiraUnleashed.Role.Scavenger.IntroBlurb">Eat dead bodies to win alone.</string>
    <string name="MiraUnleashed.Role.Scavenger.TabDescription">Eat dead bodies to win alone.</string>
    <string name="MiraUnleashed.Role.Scavenger.WikiDescription">The Scavenger is a Neutral Evil role whose goal is to eat a set amount of dead bodies. Optionally, the Scavenger can use Scavenge to get arrows pointing to corpses. If the Scavenger's win condition can no longer be met, they become the configured role.</string>
    <string name="MiraUnleashed.Role.ScavengerEat">Eat</string>
    <string name="MiraUnleashed.Role.ScavengerEat.WikiDescription">Eat a nearby dead body. This counts toward your win condition.</string>
    <string name="MiraUnleashed.Role.ScavengerScavenge">Scavenge</string>
    <string name="MiraUnleashed.Role.ScavengerScavenge.WikiDescription">Get arrows pointing to all corpses for a duration. If a corpse is on a different floor on Submerged, the arrow will point to the elevator.</string>

